{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/index.js" },
    { "src": "/adm", "dest": "server/index.js" },
    { "src": "/cara-penggunaan", "dest": "server/index.js" },
    { "src": "/larangan", "dest": "server/index.js" },
    { "src": "/donasi", "dest": "server/index.js" },
    { "src": "/(.*\\.(css|js|json|png|jpg|jpeg|svg|ico|webmanifest|txt|xml))", "dest": "public/$1" },
    { "src": "/(.*)", "dest": "server/index.js" }
  ]
}
